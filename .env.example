# OSF Personal Access Token for anonymous traffic — create at https://osf.io/settings/tokens
OSF_APP_TOKEN=
# BetterOSF runs on 4747 locally (NOT the ecosystem-default 3000, which
# collides with other projects). `npm run dev` / `npm start` pin this port.
NEXT_PUBLIC_BASE_URL=http://localhost:4747

# OSF OAuth application credentials (required for sign-in + uploads).
# Register an OSF OAuth app at https://osf.io/settings/applications/ and copy the
# client id/secret here. Without these, OSF sign-in and token refresh fail with a
# clear startup error (see src/lib/env.ts authEnv()).
AUTH_OSF_ID=
AUTH_OSF_SECRET=

# Auth.js session-encryption secret. Generate with: openssl rand -base64 32
# (or `npx auth secret`). Required for signed sessions.
AUTH_SECRET=

# Neon Postgres (EU / GDPR) — create with:
#   neonctl projects create --name betterosf-eu --region-id aws-eu-central-1
# Use the *pooled* connection string for serverless.
DATABASE_URL=

# Comma-separated OSF user guids that can open /admin/logs
ADMIN_OSF_USER_IDS=

# Optional: Vercel KV for fleet-wide rate limits (falls back to in-memory Map)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# AWS SES (EU) — interim FROM betterosf@scimeto.app (scimeto.app verified in
# eu-west-1). Do not point DKIM at betterosf.vercel.app (no DNS control).
# Migrate when BetterOSF has its own custom domain (see todo.md).
# AWS_SES_REGION=eu-west-1
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=
# EMAIL_FROM_ADDRESS=betterosf@scimeto.app
# EMAIL_FROM_NAME=BetterOSF
# EMAIL_MODE=ses
# EMAIL_CONFIG_SET=ses-events-betterosf-config
# SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:ACCOUNT:ses-events-betterosf
# ADMIN_NOTIFY_EMAIL=admin@example.org
# NEXT_PUBLIC_ADMIN_EMAIL=admin@example.org
# CRON_SECRET=

# --- Zenodo (OSF Transition Toolkit) -----------------------------------------
# Which Zenodo instance to target. "sandbox" during development — it issues test
# DOIs (10.5072) and can be wiped at any time. "production" mints REAL DOIs.
# ZENODO_ENV=sandbox
#
# OAuth applications are registered SEPARATELY per instance and the credentials are
# NOT interchangeable; pointing production credentials at sandbox fails opaquely.
# Register at <instance>/account/settings/applications/ with redirect URI
#   http://localhost:4747/api/zenodo/oauth/callback   (local — port 4747, never 3000)
#   https://<your-domain>/api/zenodo/oauth/callback   (deployed)
# Scopes: deposit:write deposit:actions
#
# The application MUST be registered as a **Confidential** client. A Public one has no
# usable secret and every grant fails with an opaque `invalid_client` — check the client
# TYPE before anything else when Zenodo OAuth misbehaves.
#
# The redirect URI is derived from NEXT_PUBLIC_BASE_URL, never from the request Host, and
# Zenodo matches it EXACTLY. If NEXT_PUBLIC_BASE_URL and the registered URI disagree by so
# much as a trailing slash, the authorize step fails.
#
# Without these set, /transition still offers a verified local export; the Zenodo panel
# says the destination is not configured on this deployment rather than half-working.
# ZENODO_CLIENT_ID=
# ZENODO_CLIENT_SECRET=
# ZENODO_SANDBOX_CLIENT_ID=
# ZENODO_SANDBOX_CLIENT_SECRET=
#
# Personal access token, used ONLY by the guarded live round-trip probe.
# Must come from a throwaway sandbox account — the probe creates records.
# ZENODO_SANDBOX_TOKEN=
