# Track ONLY the project link (ids, no secrets) so a fresh clone or agent cannot let
# `vercel deploy` create a duplicate project; everything else Vercel writes stays out.
**/.vercel/*
!**/.vercel/project.json
screenshots/

# Generated by scripts/copy-pdfjs-worker.mjs as a prebuild step.
# We ship a fresh copy of pdfjs-dist's worker into the build output, so
# the source of truth is node_modules. Don't commit the copy.
public/pdf.worker.min.mjs

# deep-review skill scratch — reports, state, and tmp are per-run working
# artifacts, not source. Keep them untracked.
.claude/skills/_project/deep-review-report-*.md
.claude/skills/_project/deep-review-state.json
.claude/skills/_project/deep-review-tmp/

# post-deploy-verify run artifacts
post-deploy-report.json
test-results/

# Internal strategy memo — reflects a confidential pre-publication communication.
# Marked NOT FOR PUBLICATION; must not enter git history.
docs/osf-exit-strategy.md
.mobile-ux-output/

communications/
